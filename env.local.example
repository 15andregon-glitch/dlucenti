# =============================================================================
# Supabase — copy to .env.local (never commit .env.local)
# =============================================================================

# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key (Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — server only, required for /admin CMS saves & uploads
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "true" when schema is applied and you want live CMS data
NEXT_PUBLIC_USE_SUPABASE=true

# =============================================================================
# Site URL (required for Stripe redirects + product images in Checkout)
# =============================================================================

NEXT_PUBLIC_SITE_URL=https://dlucenti.com

# =============================================================================
# Stripe — server only except publishable key
# =============================================================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# Resend — transactional email (server only)
# =============================================================================

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="D'LUCENTI <hello@dlucenti.com>"
ADMIN_ORDER_EMAIL=you@example.com
